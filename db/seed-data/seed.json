  "settings": [
    {
      "key": "VOL_DIVISOR",
      "value": "6000",
      "description": "Volumetric divisor used in CWT calc: Pieces x L(cm) x W(cm) x H(cm) / divisor. IATA standard = 6000. Change only if an airline tariff specifies otherwise."
    },
    {
      "key": "CWT_ROUNDING_INCREMENT",
      "value": "1",
      "description": "Rounding increment applied to Chargeable Weight, rounded UP (ceiling). Allowed: 1, 0.5, 0.1, or 0 (0 = no rounding)."
    },
    {
      "key": "BRAVAIR_MIN_MARGIN_USD_KG",
      "value": "0.52",
      "description": "Fallback minimum Bravair freight margin (USD/KG), used only when the matched RATE_ENGINE row leaves Minimum Margin USD/KG blank."
    },
    {
      "key": "CURRENCY_LABEL",
      "value": "USD",
      "description": "Currency label shown across the workbook (display only)."
    },
    {
      "key": "COMPANY_NAME",
      "value": "Bravair Logistics",
      "description": "Legal / trading name shown on the quotation header."
    },
    {
      "key": "GLOBAL_MIN_CHARGE_USD",
      "value": "350",
      "description": "Absolute minimum freight charge (USD) applied to every quotation, regardless of route, CWT, or the RATE_ENGINE minimum charge. The Freight Total will never be quoted below this figure."
    }
  ],
